# Your StockX API key
STOCKX_API_KEY=your-api-key-here

# Your StockX JWT token
STOCKX_JWT_TOKEN=your-jwt-token-here

# OAuth2 credentials (required for token refresh)
STOCKX_CLIENT_ID=your-client-id-here
STOCKX_CLIENT_SECRET=your-client-secret-here
STOCKX_REFRESH_TOKEN=your-refresh-token-here

# Optional: Test product slug for integration tests
# Default: nike-dunk-low-se-easter-w
TEST_PRODUCT_SLUG=nike-dunk-low-se-easter-w

# Optional: Test timeout in milliseconds
# Default: 30000 (30 seconds)
TEST_TIMEOUT=30000

# Optional: Delay between API calls in milliseconds (to respect rate limits)
# Default: 2000 (2 seconds)
TEST_DELAY=2000

# Optional: Enable verbose logging to see full API responses
# Default: false
VERBOSE=false
